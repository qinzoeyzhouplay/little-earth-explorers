    "a": "assets/audio/en/ui/ch1_rap_6.mp3"
  },
  "ch1.rap.7": {
    "t": "Saturn wears a hat, a ring so wide,",
    "a": "assets/audio/en/ui/ch1_rap_7.mp3"
  },
  "ch1.rap.8": {
    "t": "Uranus is blue and rolls on its side!",
    "a": "assets/audio/en/ui/ch1_rap_8.mp3"
  },
  "ch1.rap.9": {
